[connection signal="pressed" from="MainPanel/VBox/PlayButton" to="." method="_on_play_pressed"]
[connection signal="pressed" from="MainPanel/VBox/HistoryButton" to="." method="_on_history_pressed"]
[connection signal="pressed" from="MainPanel/VBox/QuitButton" to="." method="_on_quit_pressed"]
