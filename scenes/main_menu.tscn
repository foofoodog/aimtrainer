size_flags_vertical = 4
min_value = 1.0
max_value = 30.0
value = 10.0

[node name="MissesValue" type="Label" parent="MainPanel/VBox/CustomSettings/MissesHBox"]
custom_minimum_size = Vector2(45, 0)
layout_mode = 2
text = "10"

[node name="SpeedHBox" type="HBoxContainer" parent="MainPanel/VBox/CustomSettings"]
layout_mode = 2
