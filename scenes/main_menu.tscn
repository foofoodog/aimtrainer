[node name="TargetGuidePanel" type="PanelContainer" parent="MainPanel/VBox"]
layout_mode = 2

[node name="GuideVBox" type="VBoxContainer" parent="MainPanel/VBox/TargetGuidePanel"]
layout_mode = 2

[node name="GuideLabel" type="Label" parent="MainPanel/VBox/TargetGuidePanel/GuideVBox"]
layout_mode = 2
text = "• BIRDS (250 pts): Sky flyers, fast & swooping.
• BEASTS (175 pts): Ground sprinters, bounding trot.
• BRUTES (120 pts): Armored pop-up targets. Hit before they duck!
• SHOT TIMER: Easy = 20s, Medium = 10s, Hard = 5s.
• CHANCES: Easy = 15, Medium = 10, Hard = 5 (subtractive rounds at bottom)."
label_settings = SubResource("LabelSettings_card")

[node name="HSeparator2" type="HSeparator" parent="MainPanel/VBox"]
layout_mode = 2

[node name="PlayButton" type="Button" parent="MainPanel/VBox"]
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
text = "▶ START SHOOTING"

[node name="HistoryButton" type="Button" parent="MainPanel/VBox"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
