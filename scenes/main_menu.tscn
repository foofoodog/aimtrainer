[node name="QuitButton" type="Button" parent="MainPanel/VBox"]
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
text = "✕ QUIT"

[node name="HistoryWindow" type="Window" parent="."]
title = "Score History & Stats"
initial_position = 2
size = Vector2i(580, 420)
visible = false
transient = true
exclusive = true

[node name="VBox" type="VBoxContainer" parent="HistoryWindow"]
