[node name="CloseHistoryButton" type="Button" parent="HistoryWindow/VBox/BtnHBox"]
custom_minimum_size = Vector2(140, 36)
layout_mode = 2
text = "Close"

[connection signal="item_selected" from="MainPanel/VBox/ModeContainer/ModeOption" to="." method="_on_mode_selected"]
[connection signal="value_changed" from="MainPanel/VBox/CustomSettings/MissesHBox/MissesSlider" to="." method="_on_misses_slider_changed"]
