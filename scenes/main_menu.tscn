[gd_scene format=3 uid="uid://main_menu_scene"]

[ext_resource type="Script" path="res://scripts/main_menu.gd" id="1_menu"]
[ext_resource type="Script" path="res://scripts/range_background.gd" id="2_bg"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.08, 0.1, 0.14, 0.94)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.3, 0.45, 0.6, 0.8)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
content_margin_left = 32.0
content_margin_top = 20.0
content_margin_right = 32.0
content_margin_bottom = 20.0

[sub_resource type="LabelSettings" id="LabelSettings_title"]
font_size = 32
font_color = Color(1, 0.88, 0.3, 1)
outline_size = 4
outline_color = Color(0, 0, 0, 0.9)

[sub_resource type="LabelSettings" id="LabelSettings_subtitle"]
font_size = 18
font_color = Color(0.8, 0.9, 1, 0.9)

[sub_resource type="LabelSettings" id="LabelSettings_high"]
font_size = 19
font_color = Color(1, 0.8, 0.2, 1)

[sub_resource type="LabelSettings" id="LabelSettings_card"]
font_size = 13
font_color = Color(0.85, 0.9, 0.95, 0.85)

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Background" type="Node2D" parent="."]
script = ExtResource("2_bg")

[node name="MainPanel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -370.0
offset_top = -310.0
offset_right = 370.0
offset_bottom = 310.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="VBox" type="VBoxContainer" parent="MainPanel"]
layout_mode = 2
theme_override_constants/separation = 10
alignment = 1

[node name="Title" type="Label" parent="MainPanel/VBox"]
layout_mode = 2
text = "Aim Trainer - Birds, Beasts and Brutes"
label_settings = SubResource("LabelSettings_title")
horizontal_alignment = 1

[node name="HighScoreLabel" type="Label" parent="MainPanel/VBox"]
layout_mode = 2
text = "★ ALL-TIME HIGH SCORE: 0 ★"
label_settings = SubResource("LabelSettings_high")
horizontal_alignment = 1

[node name="HSeparator1" type="HSeparator" parent="MainPanel/VBox"]
layout_mode = 2

[node name="ModeContainer" type="HBoxContainer" parent="MainPanel/VBox"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="ModeTitle" type="Label" parent="MainPanel/VBox/ModeContainer"]
layout_mode = 2
text = "Difficulty:"

[node name="ModeOption" type="OptionButton" parent="MainPanel/VBox/ModeContainer"]
custom_minimum_size = Vector2(340, 36)
layout_mode = 2

[node name="CustomSettings" type="VBoxContainer" parent="MainPanel/VBox"]
visible = false
layout_mode = 2
theme_override_constants/separation = 8

[node name="MissesHBox" type="HBoxContainer" parent="MainPanel/VBox/CustomSettings"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="MissesLabel" type="Label" parent="MainPanel/VBox/CustomSettings/MissesHBox"]
custom_minimum_size = Vector2(170, 0)
layout_mode = 2
text = "Max Consecutive Misses:"

[node name="MissesSlider" type="HSlider" parent="MainPanel/VBox/CustomSettings/MissesHBox"]
layout_mode = 2
